{
    "name": "wp-racemanager",
    "version": "1.12.0",
    "scripts": {
        "test": "php tests/run.php",
      "test:e2e": "node tests/e2e/editor.cjs",
      "test:pilot-selector": "node tests/e2e/pilot-selector.cjs",
      "test:live-resume": "node tests/e2e/live-resume.cjs",
      "test:update-status": "node tests/e2e/update-status.cjs",
      "test:flaky-network": "node tests/e2e/flaky-network.cjs",
      "test:race-parts": "node tests/e2e/race-parts.cjs",
      "test:stats-filter": "node tests/e2e/stats-filter.cjs",
      "test:offline": "node tests/e2e/offline.cjs",
      "test:view-tabs": "node tests/e2e/view-tabs.cjs",
      "test:bracket-titles": "node tests/e2e/bracket-titles.cjs",
      "test:class-templates": "node tests/e2e/class-templates.cjs",
      "test:push-subscribe": "node tests/e2e/push-subscribe.cjs",
      "test:bracket-view": "node tests/e2e/bracket-view.cjs",
      "test:bracket-model": "node tests/e2e/bracket-model.cjs",
      "test:bracket-standings": "node tests/e2e/bracket-standings.cjs",
      "test:loader-subscribe": "node tests/e2e/loader-subscribe.cjs",
      "test:stats-ranking": "node tests/e2e/stats-ranking.cjs",
      "test:pilot-profiles": "node tests/e2e/pilot-profiles.cjs",
        "build": "wp-scripts build --source-path=blocks-src --output-path=blocks && npm run copy-json",
        "start": "wp-scripts start --source-path=blocks-src --output-path=blocks",
        "copy-json": "copyfiles -u 1 \"blocks-src/**/block.json\" blocks/"
    },
    "devDependencies": {
        "@wordpress/block-editor": "^17.0.0",
        "@wordpress/blocks": "^15.27.0",
        "@wordpress/components": "^40.0.0",
        "@wordpress/core-data": "^7.54.0",
        "@wordpress/data": "^10.54.0",
        "@wordpress/element": "^8.6.0",
        "@wordpress/i18n": "^6.27.0",
        "@wordpress/scripts": "^35.0.0",
        "copyfiles": "^2.4.1"
    }
}
