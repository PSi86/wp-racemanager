{
    "name": "wp-racemanager",
    "version": "1.2.0",
    "scripts": {
        "test": "php tests/run.php",
      "test:e2e": "node tests/e2e/editor.cjs",
      "test:pilot-selector": "node tests/e2e/pilot-selector.cjs",
      "test:live-resume": "node tests/e2e/live-resume.cjs",
      "test:update-status": "node tests/e2e/update-status.cjs",
      "test:flaky-network": "node tests/e2e/flaky-network.cjs",
      "test:stats-filter": "node tests/e2e/stats-filter.cjs",
        "build": "wp-scripts build --source-path=blocks-src --output-path=blocks && npm run copy-json",
        "start": "wp-scripts start --source-path=blocks-src --output-path=blocks",
        "copy-json": "copyfiles -u 1 \"blocks-src/**/block.json\" blocks/"
    },
    "devDependencies": {
        "@wordpress/block-editor": "^17.0.0",
        "@wordpress/blocks": "^15.27.0",
        "@wordpress/components": "^40.0.0",
        "@wordpress/core-data": "^7.54.0",
        "@wordpress/data": "^10.54.0",
        "@wordpress/element": "^8.6.0",
        "@wordpress/i18n": "^6.27.0",
        "@wordpress/scripts": "^34.2.0",
        "copyfiles": "^2.4.1"
    }
}
