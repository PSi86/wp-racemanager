# Everything listed here is development-only and is left out of `git archive`,
# which is how bin/build-plugin-zip.sh builds the deployable plugin ZIP.
# See docs/deployment.md.

/.devcontainer      export-ignore
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CLAUDE.md          export-ignore
/bin                export-ignore
/blocks-src         export-ignore
/docs               export-ignore
/package-lock.json  export-ignore
/package.json       export-ignore
/tests              export-ignore
/webpack.config.js  export-ignore

# Shell scripts run inside the DDEV container, where CRLF line endings make the
# shebang fail with "bad interpreter". Keep them LF regardless of core.autocrlf.
*.sh text eol=lf

# The block build copies blocks-src/**/block.json to blocks/ verbatim. Without a
# rule both sides follow core.autocrlf, and every `npm run build` then leaves the
# copy looking modified when only the line endings differ. Pin both to LF.
blocks-src/**/block.json    text eol=lf
blocks/**/block.json        text eol=lf
blocks/**/index.asset.php   text eol=lf

# Composer rewrites these with LF on every operation, so without a rule they
# come back as modified after each `composer install` on a CRLF checkout.
composer.json               text eol=lf
composer.lock               text eol=lf
